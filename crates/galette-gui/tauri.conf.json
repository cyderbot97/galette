{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galette",
  "identifier": "io.github.cyderbot97.galette",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galette",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Secure audio CD ripper",
    "publisher": "cyderbot97",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/cyderbot97/galette",
    "longDescription": "Galette rips audio CDs securely: it recognizes the disc on MusicBrainz, reads it with C2 pointers and re-reads, verifies every track with AccurateRip and writes tagged FLAC files with cover art, a cue sheet and a log.",
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  },
  "version": "0.3.0"
}
